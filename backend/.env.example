# =============================================
# DATABASE (Supabase PostgreSQL)
# =============================================
# For PRODUCTION (Leapcell): Use Supabase Transaction Pooler (port 6543)
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# For migrations: Use Supabase Direct Connection (port 5432)
DIRECT_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# =============================================
# SERVER
# =============================================
PORT=5000
NODE_ENV="production"

# =============================================
# SUPABASE AUTH
# =============================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# =============================================
# CORS - Set to your frontend production URL
# =============================================
ALLOWED_ORIGINS="https://your-frontend.vercel.app"

# =============================================
# AI SERVICE (OPTIONAL - bisa diisi setelah AI service di-deploy)
# =============================================
# AI_SERVICE_URL="https://your-ai-service.leapcell.dev"
